networks:
  {{.Project}}-network:
    driver: bridge
{{- if .Domain}}
  # Created by rocketctl deploy (shared_proxy). Caddy lives there, not in this file.
  edge:
    external: true
{{- end}}

services:
{{- range .Services}}
  {{$.Project}}-{{.}}:
    image: {{$.Registry}}/{{$.Project}}_{{.}}:${{"{"}}{{. | envkey}}:-latest{{"}"}}
    container_name: {{$.Project}}-{{.}}
    restart: unless-stopped
    env_file:
      - ./{{if $.IsMonorepo}}{{.}}/{{end}}.env
    networks:
      - {{$.Project}}-network
{{- if $.Domain}}
      # Join "edge" only if Caddy routes to this service:
      #   - edge
{{- end}}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    # Expose ports to host (uncomment for local testing or production without reverse proxy)
    # ports:
    #   - "8000:8000"  # Format: "host:container"
    # Or expose to other containers only (no host access):
    # expose:
    #   - "8000"
    # Add your service-specific configuration here (volumes, healthchecks, etc.)
{{end}}
